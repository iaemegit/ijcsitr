{
  "name": "ijcsitr",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack -H 127.0.0.1 -p 4000",
    "build": "prisma generate && next build --turbopack",
    "start": "next start -H 127.0.0.1 -p 4000",
    "test": "node --import tsx --test server/*.test.js",
    "test:integration": "node --import tsx scripts/smoke.mjs",
    "test:browser": "node --import tsx scripts/browser-check.mjs",
    "test:forms": "node --import tsx scripts/forms-check.mjs",
    "test:mysql-search": "node --import tsx scripts/mysql-search-check.mjs",
    "test:admin": "node --import tsx scripts/admin-check.mjs",
    "test:affiliation": "node --import tsx scripts/affiliation-check.mjs",
    "test:author": "node --import tsx scripts/author-check.mjs",
    "test:journal": "node --import tsx scripts/journal-check.mjs",
    "test:journal-issue": "node --import tsx scripts/journal-issue-check.mjs",
    "test:article": "node --import tsx scripts/article-admin-check.mjs",
    "test:article-documents": "node --import tsx scripts/article-documents-check.mjs",
    "test:reviewer-application": "node --import tsx scripts/reviewer-application-check.mjs",
    "test:editorial-board": "node --import tsx scripts/editorial-board-check.mjs",
    "test:membership": "node --import tsx scripts/membership-check.mjs",
    "test:awards": "node --import tsx scripts/awards-check.mjs",
    "test:call-for-paper": "node --import tsx scripts/call-for-paper-check.mjs",
    "test:admin-content": "node --import tsx scripts/admin-content-check.mjs",
