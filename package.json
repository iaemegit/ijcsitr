    "db:author-affiliations": "node --import tsx scripts/upgrade-author-affiliations.mjs",
    "db:repair-author-affiliations": "tsx scripts/repair-author-affiliations.ts",
    "admin:password": "node --import tsx scripts/admin-password.mjs",
    "admin:setup": "node --import tsx scripts/setup-admin.mjs",
    "db:setup": "node --import tsx scripts/setup-db.mjs",
    "typecheck": "tsc --noEmit",
    "db:introspect": "prisma db pull",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
